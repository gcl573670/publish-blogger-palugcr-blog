# Blogger API (Google Cloud — run `node publisher.js --auth` once to get refresh token)
BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# OpenRouter (AI rewrite model)
OPENROUTER_API_KEY=
# Better Arabic options: openai/gpt-4o-mini (cheap), openai/gpt-4o (stronger)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# News sources — fill at least one of these
GNEWS_KEY=
NEWS_DATA_IO_KEY=
YOUTUBE_API_KEY=

# Blogger post status: LIVE or DRAFT
BLOG_STATUS=LIVE

# post URL keywords: 'category' appends a Latin keyword per category to the title
# (Blogger builds URLs from title's Latin chars only, e.g. .../sports-news.html)
# Use 'none' to disable.
URL_KEYWORDS_MODE=category

# Freshness: publish only the latest news.
# MAX_NEWS_AGE_HOURS = drop articles older than N hours (0 = no limit)
MAX_NEWS_AGE_HOURS=48
# GNews window filter: 1h,4h,12h,24h,48h,7d,30d ('24h' = strictly today's news)
GNEWS_TIMEFRAME=24h

# Scheduling:
#   rotation (default) = publish 1 post every run from the next category in a loop
#   plan               = run the full daily CATEGORY_PLAN (5 posts) per run
SCHEDULE_MODE=rotation

# Google Indexing API (optional — submit new posts to Google instantly).
# 1) Enable "Indexing API" in Google Cloud for the project
# 2) Create a Service Account, download its JSON key
# 3) In Search Console, add the service account email as owner of the blog property
# 4) Base64-encode the JSON and paste it here, e.g.:
#    powershell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#    (macOS/linux): base64 -w0 service-account.json
GOOGLE_INDEXING_KEY_JSON=